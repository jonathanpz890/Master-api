{
  "name": "microserver-api",
  "version": "1.0.0",
  "description": "Production-ready API gateway foundation for micro-services.",
  "private": true,
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build": "rm -rf dist && npm run build:core && npm run build:services && npm run copy:service-assets",
    "build:core": "tsc -p tsconfig.json",
    "build:services": "tsc -p tsconfig.services.json",
    "check": "npm run typecheck && npm run lint && npm run test",
    "dev": "tsx watch src/main.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "copy:service-assets": "mkdir -p dist/services/print3d-hub dist/services/bango && cp src/services/print3d-hub/package.json dist/services/print3d-hub/package.json && cp src/services/bango/package.json dist/services/bango/package.json && cp -R src/services/print3d-hub/bbl_presets dist/services/print3d-hub/bbl_presets",
    "start": "node dist/main.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [],
  "author": "",
  "license": "UNLICENSED",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24.0.0",
    "npm": ">=10"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "axios": "^1.19.0",
    "bcrypt": "^5.1.1",
    "compression": "^1.8.1",
    "connect-mongo": "^5.1.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "express-session": "^1.19.0",
    "express-validator": "^6.15.0",
    "helmet": "^8.3.0",
    "mnemonix": "^1.1.0",
    "mongoose-bango": "npm:mongoose@^6.13.11",
    "mongoose-bynder": "npm:mongoose@^8.24.3",
    "mongoose-print3d": "npm:mongoose@^9.9.2",
    "multer": "^1.4.5-lts.2",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "passport-local": "^1.0.0",
    "passport-local-mongoose": "^7.1.2",
    "sharp": "^0.34.5",
    "uuid": "^11.1.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.2.0",
    "@types/supertest": "^7.2.1",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "supertest": "^7.2.2",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.10"
  }
}
