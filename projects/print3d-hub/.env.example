# Required admin configuration. Use a long, unique password and a 32+ byte random secret.
ADMIN_USER=admin@example.com
ADMIN_PASS=replace-with-a-long-unique-password
ADMIN_SESSION_SECRET=replace-with-at-least-32-random-bytes

# Public origin used when returning uploaded gallery image URLs.
PUBLIC_BASE_URL=https://your-api.example.com

# Optional infrastructure configuration
PORT=5001
GATEWAY_ORIGIN=http://localhost:3000
MONGODB_CONNECTION_URI=mongodb://localhost:27017/print3d-hub
BAMBU_STUDIO_PATH=/Applications/BambuStudio.app/Contents/MacOS/BambuStudio
THINGIVERSE_API_TOKEN=
